PORT=3001
APP_PASSWORD=FlipsideSecret123!
ENABLE_DEBUG_ENDPOINTS=false

# In-process rate limits
API_RATE_LIMIT_PER_MINUTE=300
AUTH_API_RATE_LIMIT_PER_MINUTE=900
AI_RATE_LIMIT_PER_HOUR=20
IMAGE_RATE_LIMIT_PER_HOUR=60
EBAY_READ_RATE_LIMIT_PER_HOUR=240
EBAY_WRITE_RATE_LIMIT_PER_HOUR=120
COMPS_RATE_LIMIT_PER_HOUR=180
AI_DAILY_TOKEN_LIMIT=100000
AI_GENERATE_QUOTA_RESERVE_TOKENS=5000
AI_OPTIMIZE_QUOTA_RESERVE_TOKENS=3000

# Server-side sold reconciliation (P1.4). Runs on an interval so sales are
# captured even when no browser tab is open. Set ENABLED=false to turn off.
SOLD_RECONCILE_ENABLED=true
SOLD_RECONCILE_INTERVAL_MINUTES=30
SOLD_RECONCILE_LOOKBACK_DAYS=90

# Google AI
GEMINI_API_KEY=YOUR_GEMINI_KEY_HERE

# eBay Authentication
EBAY_OAUTH_TOKEN=YOUR_EBAY_TOKEN_HERE
EBAY_CLIENT_ID=YOUR_CLIENT_ID_HERE
EBAY_CLIENT_SECRET=YOUR_CLIENT_SECRET_HERE
EBAY_RU_NAME=YOUR_RU_NAME_HERE

# eBay Listing Policies
EBAY_FULFILLMENT_POLICY_ID=260842273020
EBAY_PAYMENT_POLICY_ID=255621408020
EBAY_RETURN_POLICY_ID=255744046020
EBAY_MERCHANT_LOCATION_KEY=default
EBAY_DEFAULT_CATEGORY_ID=261068
